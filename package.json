{
  "name": "@rdlabo/ionic-theme-utils",
  "private": false,
  "version": "0.1.0",
  "description": "Shared utilities for Rdlabo Ionic themes",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles": "./src/styles/index.scss",
    "./styles/*": "./src/styles/*.scss"
  },
  "files": [
    "src",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "fmt:check": "prettier --check \"./**/*.{js,json,md,scss,ts,yml}\"",
    "lint": "eslint .",
    "fmt": "prettier --write \"./**/*.{js,json,md,scss,ts,yml}\"",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/rdlabo-dev/ionic-theme-utils.git"
  },
  "keywords": [
    "ionic",
    "framework",
    "theme",
    "utilities"
  ],
  "author": "Masahiko Sakakibara <sakakibara@rdlabo.jp>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rdlabo-dev/ionic-theme-utils/issues"
  },
  "homepage": "https://github.com/rdlabo-dev/ionic-theme-utils#readme",
  "peerDependencies": {
    "@ionic/core": ">=8.8.1 <10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@ionic/core": "^9.0.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
